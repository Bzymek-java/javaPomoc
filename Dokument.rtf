Zadanie 6: Implementacja podstawowych funkcji operuj\'b9cych na listachHaskell-- a) Konkatenacja dw\f1\'f3ch list\par
append :: [a] -> [a] -> [a]\par
append [] m = m\par
append (x:xs) m = x : append xs m\par
\par
-- b) Sprawdzenie czy element nale\f0\'bfy do listy\par
member :: Eq a => a -> [a] -> Bool\par
member _ [] = False\par
member x (y:ys)\par
  | x == y    = True\par
  | otherwise = member x ys\par
\par
-- c) Znalezienie ostatniego elementu\par
lastEl :: [a] -> a\par
lastEl []     = error "Pusta lista nie ma ostatniego elementu!"\par
lastEl [x]    = x\par
lastEl (_:xs) = lastEl xs\par
\par
-- d) Skasowanie PIERWSZEGO wyst\'b9pienia elementu x z listy\par
deleteEl :: Eq a => a -> [a] -> [a]\par
deleteEl _ [] = []\par
deleteEl x (y:ys)\par
  | x == y    = ys\par
  | otherwise = y : deleteEl x ys\par
\par
-- e) Podzia\'b3 na elementy mniejsze i wi\'eaksze (r\f1\'f3wne pomijamy lub wrzucamy do l2)\par
split :: Ord a => a -> [a] -> ([a], [a])\par
split _ [] = ([], [])\par
split x (y:ys)\par
  | y < x     = (y : l1, l2)\par
  | otherwise = (l1, y : l2)\par
  where\par
    (l1, l2) = split x ys\par
